# Foreman configuration. Copy to .env and edit.
#
# Every variable here is OPTIONAL. With no .env at all, Foreman runs entirely
# on the mock provider with no network and no cost.
#
# NEVER commit a real .env. This file lists variable names only, never values.

# --- Environment -------------------------------------------------------------
FOREMAN_ENV=dev

# --- Provider chains ---------------------------------------------------------
# Ordered lists. A provider with no key is skipped, not an error.
# Example: FOREMAN_TIER_SMALL=["ollama","groq"]
FOREMAN_TIER_SMALL=["mock"]
FOREMAN_TIER_LARGE=["mock"]

FOREMAN_OLLAMA_BASE_URL=http://localhost:11434

# --- Provider credentials ----------------------------------------------------
# Set only the ones you use. Set a hard spend cap on every key at the vendor:
# it is the only budget control that does not depend on this code being correct.
# FOREMAN_OPENAI_API_KEY=
# FOREMAN_ANTHROPIC_API_KEY=
# FOREMAN_GOOGLE_API_KEY=
# FOREMAN_GROQ_API_KEY=
# FOREMAN_OPENROUTER_API_KEY=

# --- Runtime -----------------------------------------------------------------
FOREMAN_RUNTIME=native
FOREMAN_MAX_STEPS=12
FOREMAN_MAX_TOKENS_PER_RUN=40000

# --- Budget ------------------------------------------------------------------
FOREMAN_MAX_COST_PER_RUN_CENTS=10
FOREMAN_MAX_COST_PER_DAY_CENTS=100
FOREMAN_KILL_SWITCH=false

# --- Optional services -------------------------------------------------------
# Each is off by default and has a tested in-process fallback.
FOREMAN_ENABLE_GRAPH_STORE=false
FOREMAN_ENABLE_PGVECTOR=false
FOREMAN_ENABLE_LANGFUSE=false

# --- Storage -----------------------------------------------------------------
FOREMAN_RUN_STORE_URL=sqlite:///./foreman.db
FOREMAN_TRACE_DIR=./traces
